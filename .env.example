# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (Firecrawl 제거됨 — 뉴스 검색은 Google News RSS 무료, 키 불필요)

# 2차 엔진(무료) — Anthropic 크레딧이 떨어져도 파이프라인이 멈추지 않게 하는 폴백.
# 발급: https://aistudio.google.com/apikey (카드 불필요, 무료 티어는 Flash 계열만)
# 주의: 무료 티어 입력은 구글 제품 개선에 쓰일 수 있다(우리 입력=공개 뉴스+환율).
GEMINI_API_KEY=
# 모델명은 자주 바뀐다. 비워두면 후보를 순서대로 시도하고, 다 막히면 사용 가능한
# flash 모델을 조회해 자동 선택한다.
GEMINI_MODEL=
